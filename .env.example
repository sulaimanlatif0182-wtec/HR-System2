# Supabase Configuration
# Get these from your Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# Vite uses these same values (prefixed with VITE_)
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Optional: Google Sign-In
# Get these from Google Cloud Console > Credentials
VITE_GOOGLE_CLIENT_ID=""
VITE_GOOGLE_AUTH_PROXY=""

# SMTP Configuration (for email notifications)
# Required for email features (leave requests, claims, payroll, etc.)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-user"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM="noreply@yourdomain.com"
SMTP_FROM_NAME="WtecHR"
SMTP_SECURE="false"

# Application Base URL (for email links, cron jobs, etc.)
APP_BASE_URL="https://hr-system2.vercel.app"

# Cron Secret (for Vercel Cron job authentication)
# Generate a strong random string: openssl rand -hex 32
CRON_SECRET="your-cron-secret-here"

# Logging
LOG_LEVEL="info"
NODE_ENV="development"

# Rate Limiting (optional - defaults work for most cases)
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=100