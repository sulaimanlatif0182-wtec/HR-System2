{
  "crons": [
    {
      "path": "/api/employees?cron_reminders=1",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/employees?announcement_cleanup=1",
      "schedule": "0 2 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}